# Copy this file to ".env" and fill in your own values.
# Never commit the real ".env" file (it's already in .gitignore).

# Found in Supabase: Project Settings -> API -> Project URL
VITE_SUPABASE_URL=

# Found in Supabase: Project Settings -> API -> Project API keys -> anon public
VITE_SUPABASE_ANON_KEY=

# Any PIN you both agree on, e.g. 4821. Leave empty to disable the PIN screen entirely.
VITE_APP_PIN=
